generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String
  role         String             @default("USER")
  sftpUsername String?            @unique
  serverAccess UserServerAccess[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ServerNode {
  id        String       @id @default(cuid())
  name      String
  baseUrl   String
  publicIp  String       @default("")
  apiToken  String
  isLocal   Boolean      @default(false)
  servers   GameServer[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model GameServer {
  id                 String             @id @default(cuid())
  nodeId             String?
  node               ServerNode?        @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  name               String
  description        String
  systemdServiceName String             @unique
  execStart          String             @default("")
  fsGame             String             @default("")
  punkbuster         Boolean            @default(false)
  configFile         String             @default("")
  rconPassword       String             @default("")
  extraParameters    String             @default("")
  status             String             @default("UNKNOWN")
  desiredState       String             @default("STOPPED")
  lastDownAlertAt    DateTime?
  displayOrder       Int                @default(0)
  assignedUsers      UserServerAccess[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model UserServerAccess {
  userId       String
  serverId     String
  displayOrder Int        @default(0)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  server       GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
}
